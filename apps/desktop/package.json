{
  "name": "desktop",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "app": "tauri dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "check-supplement-context": "if [ ! -d resources/tauri-plugin-clerk ]; then echo \"tauri-plugin-clerk not found\" && exit 1; fi && if [ ! -d resources/clerk-fapi-rs ]; then echo \"clerk-fapi-rs not found\" && exit 1; fi",
    "install-supplement-context": "if [ ! -d resources/tauri-plugin-clerk ]; then git clone https://github.com/Nipsuli/tauri-plugin-clerk.git resources/tauri-plugin-clerk; fi && if [ ! -d resources/clerk-fapi-rs ]; then git clone https://github.com/Nipsuli/clerk-fapi-rs.git resources/clerk-fapi-rs; fi"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.37.4",
    "@radix-ui/react-compose-refs": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-primitive": "^2.1.4",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-deep-link": "~2.4.7",
    "@tauri-apps/plugin-http": "~2.5.7",
    "@tauri-apps/plugin-opener": "~2.5.3",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^0.475.0",
    "next": "^15.5.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tauri-plugin-clerk": "^0.1.0"
  },
  "devDependencies": {
    "@clerk/clerk-js": "^5.123.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
