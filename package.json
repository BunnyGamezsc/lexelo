{
  "name": "lexelo-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "app": "turbo app",
    "lint": "turbo lint --continue",
    "turbo": "turbo",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
